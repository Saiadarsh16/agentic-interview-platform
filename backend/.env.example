APP_NAME=Agentic Interview Platform API
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentic-interview-platform
PINECONE_NAMESPACE=interview-documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/interview_platform
REDIS_URL=redis://localhost:6379/0
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_CHUNK_SIZE=2000
DOCUMENT_CHUNK_OVERLAP=200
